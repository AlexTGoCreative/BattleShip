{
  "name": "battleship-frontend",
  "version": "1.0.0",
  "description": "Battleship Game Frontend",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --open --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js --mode=production",
    "build:clean": "rm -rf dist && npm run build",
    "test": "jest",
    "test:watch": "jest --watch --onlyChanged __tests__",
    "format": "prettier . --write",
    "lint": "eslint . --fix",
    "preview": "webpack serve --config webpack.prod.js"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.4",
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jest": "^27.6.3",
    "eslint-plugin-prettier": "^5.1.3",
    "html-webpack-plugin": "^5.5.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^5.10.0"
  },
  "keywords": ["battleship", "game", "frontend"],
  "author": "Tony Fred",
  "license": "MIT"
}