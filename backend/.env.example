# Battleship Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/battleship
# For production: mongodb+srv://username:password@cluster.mongodb.net/battleship

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here

# Server Configuration  
PORT=3001
NODE_ENV=development

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:8080
# For production: https://your-app.netlify.app

# Socket.IO Configuration
SOCKET_CORS_ORIGIN=http://localhost:8080
# For production: https://your-app.netlify.app